{
  "domain": "hommyn_local_mqtt",
  "name": "Hommyn local MQTT",
  "codeowners": ["@codewec", "@udocs-ru"],
  "config_flow": true,
  "dependencies": ["mqtt"],
  "documentation": "https://github.com/udocs-ru/hommyn_local_mqtt",
